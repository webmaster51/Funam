---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';

interface Props {
  programa: CollectionEntry<'programas'>;
}

const { programa } = Astro.props;
const { titulo, tipo, facultad, duracion, modalidad, snies, imagen, imagenAlt, perfilEgresado } =
  programa.data;

const tipoLabel: Record<string, string> = {
  pregrado: 'Pregrado',
  'educacion-continua': 'Educación Continua',
};

const modalidadLabel: Record<string, string> = {
  presencial: 'Presencial',
  virtual: 'Virtual',
  hibrida: 'Híbrida',
};
---

<header class="grid gap-8 lg:grid-cols-2 lg:items-center">
  <div class="overflow-hidden rounded-xl shadow-sm">
    <Image src={imagen} alt={imagenAlt} class="h-full w-full object-cover" />
  </div>

  <div>
    <div class="flex flex-wrap gap-2">
      <span class="rounded-full bg-verde-esperanza/15 px-3 py-1 text-xs font-semibold text-verde-texto">
        {tipoLabel[tipo]}
      </span>
      <span class="rounded-full bg-azul-institucional/10 px-3 py-1 text-xs font-semibold text-azul-institucional">
        {modalidadLabel[modalidad]}
      </span>
      <span class="rounded-full bg-azul-institucional/10 px-3 py-1 text-xs font-semibold text-azul-institucional">
        SNIES {snies}
      </span>
    </div>

    <h1 class="mt-4 font-heading text-3xl font-extrabold text-azul-institucional sm:text-4xl">
      {titulo}
    </h1>
    <p class="mt-2 text-sm font-medium text-azul-institucional/70">
      {facultad} · Duración: {duracion}
    </p>

    <a
      href="/admisiones"
      class="mt-6 inline-flex items-center justify-center rounded-xl bg-dorado-cta px-6 py-3 font-semibold text-azul-institucional shadow-sm transition-colors hover:bg-dorado-cta-oscuro hover:text-fondo-claro"
    >
      Inscribirme
    </a>

    <h2 class="mt-8 font-heading text-lg font-bold text-azul-institucional">Perfil del egresado</h2>
    <ul class="mt-3 space-y-2">
      {
        perfilEgresado.map((item) => (
          <li class="flex items-start gap-2 text-sm text-azul-institucional/85">
            <svg class="mt-0.5 h-5 w-5 shrink-0 text-verde-texto" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path fill-rule="evenodd" d="M16.7 5.3a1 1 0 010 1.4l-7 7a1 1 0 01-1.4 0l-3-3a1 1 0 111.4-1.4L8 11.6l6.3-6.3a1 1 0 011.4 0z" clip-rule="evenodd" />
            </svg>
            {item}
          </li>
        ))
      }
    </ul>
  </div>
</header>
