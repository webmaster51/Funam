---
import { eventosCalendario } from '@/data/calendario';
---

<section class="bg-fondo-claro py-16" aria-labelledby="calendario-heading">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <h2 id="calendario-heading" class="font-heading text-3xl font-bold text-azul-institucional">
      Calendario Académico
    </h2>
    <p class="mt-2 max-w-2xl text-azul-institucional/70">
      Fechas clave de matriculación e inscripciones para el próximo periodo.
    </p>

    <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        eventosCalendario.map((evento) => (
          <li class="flex gap-4 rounded-xl bg-white p-5 shadow-sm">
            <div class="flex shrink-0 flex-col items-center justify-center rounded-lg bg-verde-texto px-3 py-2 text-fondo-claro">
              <span class="text-xl font-extrabold leading-none">{evento.dia}</span>
              <span class="text-xs font-semibold uppercase">{evento.mes}</span>
            </div>
            <div>
              <h3 class="font-heading text-sm font-bold text-azul-institucional">{evento.titulo}</h3>
              <p class="mt-1 text-xs text-azul-institucional/70">{evento.descripcion}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>
