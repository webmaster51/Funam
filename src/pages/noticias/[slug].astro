---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const noticias = await getCollection('noticias', ({ data }) => !data.draft);
  return noticias.map((noticia) => ({
    params: { slug: noticia.id },
    props: { noticia },
  }));
}

const { noticia } = Astro.props;
const { Content } = await render(noticia);

const formateador = new Intl.DateTimeFormat('es-CO', { day: 'numeric', month: 'long', year: 'numeric' });
---

<BaseLayout
  title={noticia.data.titulo}
  description={noticia.data.resumen}
  image={noticia.data.imagen}
  schemaType="Article"
>
  <article class="mx-auto max-w-3xl px-4 py-16 sm:px-6 lg:px-8">
    <p class="text-xs font-semibold uppercase tracking-wide text-dorado-cta-oscuro">
      {noticia.data.categoria}
    </p>
    <h1 class="mt-2 font-heading text-3xl font-extrabold text-azul-institucional sm:text-4xl">
      {noticia.data.titulo}
    </h1>
    <p class="mt-3 text-sm text-azul-institucional/60">
      Por {noticia.data.autor} ·{' '}
      <time datetime={noticia.data.fecha.toISOString()}>{formateador.format(noticia.data.fecha)}</time>
    </p>

    <Image
      src={noticia.data.imagen}
      alt={noticia.data.imagenAlt}
      class="mt-8 w-full rounded-xl object-cover shadow-sm"
    />

    <div class="prose prose-slate mt-8 max-w-none">
      <Content />
    </div>
  </article>
</BaseLayout>
