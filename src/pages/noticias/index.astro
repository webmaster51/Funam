---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';

const noticias = (await getCollection('noticias', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.fecha.valueOf() - a.data.fecha.valueOf()
);

const formateador = new Intl.DateTimeFormat('es-CO', { day: 'numeric', month: 'long', year: 'numeric' });

const categoriaLabel: Record<string, string> = {
  evento: 'Evento',
  boletin: 'Boletín',
  institucional: 'Institucional',
  admisiones: 'Admisiones',
};
---

<BaseLayout
  title="Noticias"
  description="Boletines, eventos y noticias institucionales de la Fundación Universitaria del Alto Magdalena."
  schemaType="EducationalOrganization"
>
  <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
    <h1 class="font-heading text-3xl font-extrabold text-azul-institucional sm:text-4xl">
      Noticias y eventos
    </h1>

    <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        noticias.map((noticia) => (
          <article class="flex flex-col overflow-hidden rounded-xl border border-azul-institucional/10 shadow-sm transition-shadow hover:shadow-md">
            <Image
              src={noticia.data.imagen}
              alt={noticia.data.imagenAlt}
              class="h-44 w-full object-cover"
            />
            <div class="flex flex-1 flex-col p-5">
              <span class="text-xs font-semibold uppercase tracking-wide text-dorado-cta-oscuro">
                {categoriaLabel[noticia.data.categoria]}
              </span>
              <h2 class="mt-2 font-heading text-lg font-bold text-azul-institucional">
                {noticia.data.titulo}
              </h2>
              <p class="mt-2 flex-1 text-sm text-azul-institucional/70">{noticia.data.resumen}</p>
              <div class="mt-4 flex items-center justify-between text-xs text-azul-institucional/50">
                <time datetime={noticia.data.fecha.toISOString()}>
                  {formateador.format(noticia.data.fecha)}
                </time>
                <a href={`/noticias/${noticia.id}`} class="font-semibold text-verde-texto hover:underline">
                  Leer más &rarr;
                </a>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </section>
</BaseLayout>
