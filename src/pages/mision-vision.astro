---
import BaseLayout from '@/layouts/BaseLayout.astro';

const valoresYPrincipios = [
  {
    titulo: 'Paz e Irenología',
    descripcion:
      'Compromiso con la formación en comprensión, manejo y resolución constructiva de conflictos para la cohesión social.',
  },
  {
    titulo: 'Solidaridad y Economía Cooperativa',
    descripcion:
      'Fomento del apoyo mutuo entre generaciones y sectores económicos para el bienestar de la región Surcolombiana.',
  },
  {
    titulo: 'Compromiso con los ODS',
    descripcion:
      'Aporte activo a los Objetivos de Desarrollo Sostenible alineados con los planes de desarrollo regional y nacional.',
  },
];
---

<BaseLayout
  title="Misión y Visión | FUNAM"
  description="Conoce la Misión y Visión oficial de la Fundación Universitaria del Alto Magdalena aprobadas en el Proyecto Educativo Institucional (PEI)."
  schemaType="EducationalOrganization"
>
  <section class="mx-auto max-w-5xl px-4 py-16 sm:px-6 lg:px-8">
    <!-- Encabezado -->
    <h1 class="font-heading text-3xl font-extrabold text-azul-institucional sm:text-4xl">
      Misión y Visión
    </h1>
    <p class="mt-3 max-w-2xl text-azul-institucional/70">
      Principios y proyección institucional establecidos en el Proyecto Educativo Institucional (PEI - Acuerdo 001 de 2025).
    </p>

    <!-- Tarjetas Misión y Visión -->
    <div class="mt-10 grid gap-8 md:grid-cols-2">
      <!-- Misión -->
      <div class="rounded-xl border border-azul-institucional/10 bg-white p-8 shadow-sm flex flex-col justify-between">
        <div>
          <span class="inline-block rounded-lg bg-verde-texto/10 px-3 py-1 text-xs font-bold uppercase tracking-wider text-verde-texto">
            Misión
          </span>
          <h2 class="mt-4 font-heading text-2xl font-bold text-azul-institucional">
            Nuestra Razón de Ser
          </h2>
          <p class="mt-4 text-azul-institucional/80 leading-relaxed">
            Promover una educación superior pertinente y de calidad, que forme profesionales éticos y comprometidos con el desarrollo humano integral, enfocados en la paz, la irenología, la excelencia académica, la sensibilidad humana y la solidaridad. Nuestra institución se dedica a aportar al cumplimiento de los Objetivos de Desarrollo Sostenible (ODS) a través de un enfoque cooperativo y solidario con la comunidad de la región Surcolombiana.
          </p>
        </div>
      </div>

      <!-- Visión -->
      <div class="rounded-xl border border-azul-institucional/10 bg-white p-8 shadow-sm flex flex-col justify-between">
        <div>
          <span class="inline-block rounded-lg bg-dorado-cta/20 px-3 py-1 text-xs font-bold uppercase tracking-wider text-azul-institucional">
            Visión (2035)
          </span>
          <h2 class="mt-4 font-heading text-2xl font-bold text-azul-institucional">
            Nuestra Proyección
          </h2>
          <p class="mt-4 text-azul-institucional/80 leading-relaxed">
            Ser reconocida como una institución líder en la educación superior del Huila en el año 2035, que ofrece programas innovadores y pertinentes, especialmente en el área de la salud, formando profesionales éticos y de alta calidad académica que contribuyan al desarrollo social, económico regional y a la justicia social en el territorio.
          </p>
        </div>
      </div>
    </div>

    <!-- Ejes Fundamentales -->
    <h2 class="mt-16 font-heading text-2xl font-bold text-azul-institucional">
      Ejes Misionales
    </h2>
    <div class="mt-6 grid gap-6 sm:grid-cols-3">
      {
        valoresYPrincipios.map((item) => (
          <div class="rounded-xl bg-fondo-claro p-6 border border-azul-institucional/5">
            <h3 class="font-heading text-base font-bold text-verde-texto">{item.titulo}</h3>
            <p class="mt-2 text-sm text-azul-institucional/70 leading-relaxed">{item.descripcion}</p>
          </div>
        ))
      }
    </div>

    <!-- Call to Action -->
    <div class="mt-16 rounded-xl bg-azul-institucional p-8 text-center text-fondo-claro">
      <h2 class="font-heading text-2xl font-bold">Conoce nuestra Estructura Orgánica</h2>
      <p class="mt-2 text-fondo-claro/85">Descubre cómo nos organizamos para cumplir nuestros objetivos institucionales.</p>
      <a
        href="/quienes-somos"
        class="mt-6 inline-flex items-center justify-center rounded-xl bg-dorado-cta px-6 py-3 font-semibold text-azul-institucional hover:bg-dorado-cta-oscuro hover:text-fondo-claro transition-colors"
      >
        Ver Gobierno Escolar y Directivos
      </a>
    </div>
  </section>
</BaseLayout>