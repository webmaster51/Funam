---
import type { ImageMetadata } from 'astro';
import SEO from '@/components/common/SEO.astro';
import Header from '@/components/common/Header.astro';
import Footer from '@/components/common/Footer.astro';
import '@/styles/global.css';

interface Props {
  title: string;
  description: string;
  image?: ImageMetadata | string;
  schemaType?: 'EducationalOrganization' | 'Article' | 'WebPage';
  noindex?: boolean;
}

const { title, description, image, schemaType, noindex } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <SEO title={title} description={description} image={image} schemaType={schemaType} noindex={noindex} />
  </head>
  <body class="flex min-h-screen flex-col font-body text-fondo-claro">
    <a
      href="#main-content"
      class="sr-only-focusable fixed left-4 top-4 z-50 rounded-md bg-dorado-cta px-4 py-2 font-semibold text-fondo-claro"
    >
      Saltar al contenido principal
    </a>
    <Header />
    <main id="main-content" class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
