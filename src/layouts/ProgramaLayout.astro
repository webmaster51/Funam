---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import FichaPrograma from '@/components/programas/FichaPrograma.astro';
import PlanEstudios from '@/components/programas/PlanEstudios.astro';
import Requisitos from '@/components/programas/Requisitos.astro';

interface Props {
  programa: CollectionEntry<'programas'>;
}

const { programa } = Astro.props;
const { titulo, resumen, imagen } = programa.data;
---

<BaseLayout
  title={titulo}
  description={resumen}
  image={imagen}
  schemaType="EducationalOrganization"
>
  <article class="mx-auto max-w-5xl px-4 py-10 sm:px-6 lg:px-8">
    <FichaPrograma programa={programa} />

    <div class="prose prose-slate mt-10 max-w-none">
      <slot />
    </div>

    <div class="mt-10 grid gap-10 lg:grid-cols-2">
      <PlanEstudios planEstudios={programa.data.planEstudios} />
      <Requisitos requisitosAdmision={programa.data.requisitosAdmision} />
    </div>
  </article>
</BaseLayout>
